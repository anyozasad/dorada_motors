# Seguridad del backend Dorada Motors en XAMPP/Apache.
# La aplicacion y las imagenes publicas siguen funcionando.
Options -Indexes

<FilesMatch "(?i)^(?:\.env(?:\..*)?|.*\.(?:sql|sqlite|db|bak|backup|log|jsonl))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# En Apache/XAMPP algunas configuraciones PHP-CGI no entregan el
# encabezado Bearer directamente al script. Conservarlo para login móvil.
<IfModule mod_setenvif.c>
    SetEnvIfNoCase Authorization "^(.+)$" HTTP_AUTHORIZATION=$1
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
