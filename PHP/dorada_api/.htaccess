# Seguridad del backend Dorada Motors en XAMPP/Apache.
# La aplicacion y las imagenes publicas siguen funcionando.
Options -Indexes

<FilesMatch "(?i)^(?:\.env(?:\..*)?|.*\.(?:sql|sqlite|db|bak|backup|log|jsonl))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
